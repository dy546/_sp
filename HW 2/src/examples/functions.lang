// Function examples

// Function definition
func add(a, b) {
    return a + b;
}

func factorial(n) {
    if n <= 1 {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

// Function calls
let result1 = add(5, 7);
print("5 + 7 = " + result1);

let result2 = add(10, 20);
print("10 + 20 = " + result2);

// Recursive function
let fact5 = factorial(5);
print("5! = " + fact5);